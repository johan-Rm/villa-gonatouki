    {% block sorting_form %}
        {{ include('components/_sorting_form.html.twig', {
            _entity_config: _entity_config,
        }, with_context = false) }}
    {% endblock sorting_form %}
    <script type="text/javascript">
        $('.action-sorting-gallery').on('click', function(e) {
            // e.preventDefault();
            $('#modal-sorting-gallery').modal(
                { 
                    escapeClose: false
                    , clickClose: false
                    , showClose: false
                }
            );
        });
    </script>

    <script type="text/javascript">
        $('.action-save-order').on('click', function(e) {
            e.preventDefault();
            $('#modal-sorting-gallery').modal(
                { 
                    escapeClose: false
                    , clickClose: false
                    , showClose: false
                }
            );
            var elements = $('.list-imagegallery #sortable > tr');
            var results = []
            elements.each(function( index,element ) {
                var id = $(element).attr('data-id');
                var position = parseInt($(element).find('.sorted span').html());
                results.push({ 'id': id, 'position': position })
            });

            let url = "{{ path('easyadmin_sort', { action: 'sort', id: '_entityId', position: '_endPosition' }) }}";

            $.ajax({
                type: "POST",     
                url: url,
                data: { 'results' : results }
            })
            .done(function(res) {
                window.location.reload();
            })
            .fail(function(err) {
                console.log(err)
                alert("An error occurred while sorting. Please refresh the page and try again.")
            })
        });
    </script>

    <script>
        $( function() {

            $('.list-imagegallery #sortable').sortable({
                helper: fixWidthHelper,
                update: function (event, ui) {
                    var entityId = $(ui.item).attr('data-id');
                    // var position = ui.item.index();
                    var up = true
                    if(ui.position.top < ui.originalPosition.top) {
                        up = false
                    }
                    var itemPosition = parseInt(ui.item.find('.sorted span').html());
                }
            }).disableSelection();

            function fixWidthHelper(e, ui) {
                ui.children().each(function() {
                    $(this).width($(this).width());
                });

                return ui;
            }
        
        });
    </script>
{% endblock %}
