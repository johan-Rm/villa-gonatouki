                    let deleteForm = $('#download-form');
                    deleteForm.attr('action', deleteForm.attr('action').replace('__id__', id));
                    deleteForm.trigger('submit');
            });
        });
    </script>
    <script type="text/javascript">
        Dropzone.autoDiscover = false;
        $(document).ready(function(){
            var _actionToDropZone = $("#media-dropzone-download").attr('action');
            var myDropzone = new Dropzone(
                "#media-dropzone-download"
                , { 
                    url: _actionToDropZone,
                    maxFiles: 10,
                    maxFilesize: 20,
                    timeout: 900000,
                    // parallelUploads: 10,
                    // uploadMultiple: false,
                    // autoProcessQueue: true,
                    success: function (file, response, data) {
                        // console.log('success dropzone')
                        // console.log(file)
                        // console.log(response)
                        // console.log(data)
                        var message = 'Le téléchargement est terminé, veuillez fermer la popup.';
                        var elem = $("#modal-download .message");
                        if(elem.hasClass( "alert-info" )) {
                            elem.addClass('alert-success').removeClass('alert-info');
                        }
                        $("#modal-download .message-text").text(message);
                    },
                    error: function (file, response) {
                        // console.log('error dropzone')
                        // console.log(file)
                        // console.log(response)
                        var message = 'Une erreur innatendue est survenue, veuillez recommencer.';
                        var elem = $("#modal-download .message");
                        if(elem.hasClass( "alert-info" )) {
                            elem.addClass('alert-danger').removeClass('alert-info');
                        }
                        $("#modal-download .message-text").text(message);
                    },
                     //Called just before each file is sent
                    sending: function(file, xhr, formData) {

                            for (var pair of formData.entries()) {
                                console.log(pair[0]+ ': ' + pair[1]);
                            }


                         //Execute on case of timeout only
                         xhr.ontimeout = function(e) {
                            //Output timeout error message here
                            var message = 'Temps de téléchargement dépassé, veuillez recommencer.';
                            var elem = $("#modal-download .message");
                            if(elem.hasClass( "alert-info" )) {
                                elem.addClass('alert-danger').removeClass('alert-info');
                            }
                            $("#modal-download .message-text").text(message);
                         }
                    },
                    init: function() {
                        this.on("processing", function(file) { 
                            console.log("process file.");
                            var elem = $("#modal-download .message");
                            var message = $("#modal-download .message-text-initial").text();
                            if(elem.hasClass( "alert-danger" )) {
                                elem.addClass('alert-info').removeClass('alert-danger');
                            } else if(elem.hasClass( "alert-success" )) {
                                elem.addClass('alert-info').removeClass('alert-success');
                            }
                            $("#modal-download .message-text").text(message);
                        });
                    }
                }
            );
        });
    </script>
