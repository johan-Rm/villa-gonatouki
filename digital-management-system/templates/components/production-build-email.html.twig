<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noodp, noimageindex, notranslate, nocache" />
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta name="generator" content="EasyAdmin" />
    <meta name="google-signin-scope" content="profile email">
    <meta name="google-signin-client_id" content="953423502628-mlj0q31mf082asvpka7fja1crcj8ebcl.apps.googleusercontent.com">
	<link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" rel="stylesheet">
  <style type="text/css">
  .alert {
    position: relative;
padding: .75rem 1.25rem;
margin-bottom: 1rem;
border: 1px solid
transparent;
    border-top-color: transparent;
    border-right-color: transparent;
    border-bottom-color: transparent;
    border-left-color: transparent;
border-radius: .25rem;
  }
  </style>
</head>
<body style="margin: 0 auto;padding: 0;height: 100%;width: 100%; mso-line-height-rule: exactly;background-color: #f1f1f1;color: #000;font-family: Poppins, Arial">
   <center style="width: 100%;background-color: #79a3b1;color: #000">
      <div style="max-width: 600px; margin: 0 auto;background-color: #fff">
         <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;">
            <tr>
               <td valign="top" style="background-color: #3e2723">
                  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                     <tr>
                        <td width="100%" class="logo" style="text-align: left;padding: 20px 30px;">
                           <nav class="navbar" role="navigation" style="background-color: #3e2723;padding: 20px 30px;border-radius: 0;border: 0">
                              <div id="header-logo"> <img width="220" src="{{logo}}"> </div>
                           </nav>
                        </td>
                     </tr>
                  </table>
               </td>
            </tr>
            <tr>
               <td class="bg_white">
                  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                     <tr>
                        <td class="bg_white email-section">
                           <div class="heading-section" style="text-align: center; padding: 0 30px;">
                              <h1 style="text-transform: uppercase;padding: 0 20px;font-size: 1.5em">{{ title }}</h1>
                              {% if status %}
                                 <div class="alert alert-success" role="alert" style="color:#155724;background-color:#d4edda;border-color:#c3e6cb;">
                                  <h4 class="alert-heading" style="color:#155724;">
                                    Mise à jour effectuée avec succès
                                  </h4>
                                  <p>
                                    Celle-çi sont désormais visible sur le site web<br/>
                                    <a style="color:#155724;" href="{{ viewHost }}">{{ viewHost }}</a>
                                  </p>
                                </div>
                              {% else %}
                                <div class="alert alert-danger" role="alert" style="color:#721c24;background-color:#f8d7da;border-color:#f5c6cb;">
                                  <h4 class="alert-heading" style="color:#155724;">
                                    Une erreur est survenue lors de la mise à jour
                                  </h4>
                                  <p>
                                    veuillez contacter votre développeur <br/>
                                    <a style="color:#155724;" href="mailto:{{ mailerAdmin }}">{{ mailerAdmin }}</a>
                                  </p>
                                </div>
                              {% endif %}
                              
                              <div class="list-section" style="text-align: left; padding: 0 30px;">
                                <h4 style="color:#000;">Liens mis à jour :</h4>
                                  <ul style="color:#000;">
                                  {% for log in logs %}
                                    <li>{{ log }}</li>
                                  {% endfor %}
                                </ul>
                              </div>
                             
                           </div>
                        </td>
                     </tr>
                  </table>
               </td>
            </tr>
         </table>
         <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;">
            <tr>
               <td valign="middle" style="padding:1.5em;background-color: #3e2723">
                  <table>
                     <tr>
                        <td valign="top" width="100%">
                           <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                              <tr>
                                 <td style="text-align: left; padding-right: 10px;">
                                    <p style="color: #fff">&copy; 2019 L'Immoblière d'Essaouira conçu par <a href="mailto:johan.remy@graines-digitales.online" style="color: #79a3b1;text-decoration: none;">Graines Digitales</a>.</p>
                                 </td>
                              </tr>
                           </table>
                        </td>
                     </tr>
                  </table>
               </td>
            </tr>
         </table>
      </div>
   </center>
</body>
</html>
