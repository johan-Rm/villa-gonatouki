{% set imageFilters = ['image/jpg', 'image/jpeg', 'image/png', 'image/webp'] %}
{% set otherFilters = ['text/plain', 'application/pdf'] %}

{% if item.encodingFormat is defined and item.encodingFormat in imageFilters %}
    <a href="#" class="easyadmin-thumbnail" data-featherlight="#easyadmin-lightbox-{{ item.id }}" data-featherlight-close-on-click="anywhere">
        {# the second parameter is the name of the property with the UploadableField annotation #}
        <img src="{{ asset(item.filename, 'medias') }}">
    </a>
    <div id="easyadmin-lightbox-{{ item.id }}" class="easyadmin-lightbox">
        {# the second parameter is the name of the property with the UploadableField annotation #}
        <img src="{{ asset(item.filename, 'medias') }}">
    </div>
{% elseif item.encodingFormat is defined and item.encodingFormat in otherFilters %}

    <a href="{{ asset(item.filename, 'medias') }}">Voir le document</a>

{% elseif item.encodingFormat is defined and item.encodingFormat in 'video/youtube' %}
    <a target="_BLANK" href="{{ item.url }}">Voir la vidéo</a>
{% else %}
    <span class="label">Aucun(e)</span>
{% endif %}
