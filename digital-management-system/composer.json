{
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^7.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/core": "^2.4",
        "beberlei/doctrineextensions": "^1.2",
        "cocur/slugify": "^3.2",
        "composer/package-versions-deprecated": "^1.11",
        "doctrine/annotations": "^1.0",
        "doctrine/doctrine-bundle": "^1.11",
        "doctrine/doctrine-migrations-bundle": "^2.0",
        "doctrine/inflector": "^1.3",
        "doctrine/orm": "^2.7",
        "easycorp/easyadmin-bundle": "^2.3",
        "friendsofsymfony/ckeditor-bundle": "^2.1",
        "friendsofsymfony/rest-bundle": "^2.5",
        "friendsofsymfony/user-bundle": "~2.0",
        "gesdinet/jwt-refresh-token-bundle": "^0.9.1",
        "google/cloud-translate": "^1.2",
        "jms/serializer-bundle": "^2.4",
        "knplabs/knp-menu-bundle": "^2.2",
        "knplabs/knp-snappy-bundle": "^1.5",
        "league/html-to-markdown": "^5.0",
        "lexik/jwt-authentication-bundle": "^2.6",
        "liip/imagine-bundle": "^2.0",
        "moskalyovd/fcm-bundle": "^0.3.0",
        "nelmio/cors-bundle": "^1.5",
        "overblog/graphql-bundle": "^0.11.10",
        "phpdocumentor/reflection-docblock": "^5.2",
        "sensio/framework-extra-bundle": "^5.2",
        "stof/doctrine-extensions-bundle": "^1.3",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "4.2.*",
        "symfony/config": "4.2.*",
        "symfony/console": "4.2.*",
        "symfony/css-selector": "4.2.*",
        "symfony/dom-crawler": "4.2.*",
        "symfony/dotenv": "4.2.*",
        "symfony/expression-language": "4.2.*",
        "symfony/filesystem": "4.2.*",
        "symfony/finder": "4.2.*",
        "symfony/flex": "^1.1",
        "symfony/framework-bundle": "4.2.*",
        "symfony/http-client": "4.4.2",
        "symfony/lock": "4.2.*",
        "symfony/process": "4.2.*",
        "symfony/property-access": "4.2.*",
        "symfony/property-info": "4.2.*",
        "symfony/proxy-manager-bridge": "4.2.*",
        "symfony/security-bundle": "4.2.*",
        "symfony/serializer": "4.2.*",
        "symfony/swiftmailer-bundle": "^3.2",
        "symfony/translation": "4.2.*",
        "symfony/twig-bundle": "4.2.*",
        "symfony/validator": "4.2.*",
        "symfony/web-server-bundle": "4.2.*",
        "symfony/webpack-encore-bundle": "^1.0",
        "symfony/yaml": "4.2.*",
        "tattali/calendar-bundle": "1.1.8",
        "vich/uploader-bundle": "^1.8",
        "willdurand/faker-bundle": "^1.4"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "ckeditor:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "4.2.*"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.1",
        "fzaninotto/faker": "^1.8",
        "overblog/graphiql-bundle": "^0.1.2",
        "symfony/debug-bundle": "4.2.*",
        "symfony/maker-bundle": "^1.13",
        "symfony/monolog-bundle": "^3.0",
        "symfony/stopwatch": "4.2.*",
        "symfony/var-dumper": "4.2.*",
        "symfony/web-profiler-bundle": "4.2.*"
    }
}
